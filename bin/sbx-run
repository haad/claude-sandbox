#!/bin/bash
# Run Claude Code in a hardened Apple container against an untrusted repo.
#
#   sbx-run <untrusted-repo-dir> [claude args | bash]
#
# Key:   macOS Keychain item "claude-sandbox" (see sbx-key in sandbox.zsh),
#        or SANDBOX_ANTHROPIC_KEY in the environment.
# Env:   SBX_ROOT       untrusted zone on the host     (default ~/sandbox, output in $SBX_ROOT/out)
#        ALLOWED_HOSTS  egress, space separated       (default api.anthropic.com)
#        SBX_CPUS / SBX_MEM                           (default 4 / 4g)
set -euo pipefail
. "$(cd "$(dirname "$0")/../lib" && pwd)/lib.sh"

SRC="${1:?usage: sbx-run <untrusted-repo-dir> [claude args]}"; shift || true

# --- guards -----------------------------------------------------------------
[ -d "$SRC" ] || { echo "sbx-run: '$SRC' is not a directory" >&2; exit 1; }
SRC="$(cd "$SRC" && pwd -P)"
case "$SRC" in
  /|/Users|/Volumes|/Volumes/*/|"$HOME"|/System*|/private*|/etc*|/var*)
    echo "sbx-run: refusing to mount '$SRC' into an untrusted sandbox" >&2; exit 1;;
esac
case "$HOME/" in "$SRC"/*)
    echo "sbx-run: '$SRC' contains your home directory, refusing" >&2; exit 1;;
esac
if [ "$(echo "$SRC" | tr -cd / | wc -c)" -lt 4 ]; then
  echo "sbx-run: '$SRC' is too shallow (need at least /a/b/c/repo), refusing" >&2; exit 1
fi
for f in .ssh .aws .gnupg .kube; do
  [ -e "$SRC/$f" ] && { echo "sbx-run: '$SRC/$f' exists in the source dir, refusing" >&2; exit 1; }
done
sbx_require_runtime

# --- key: keychain first, env override, never on the command line -------------
if [ -z "${SANDBOX_ANTHROPIC_KEY:-}" ]; then
  SANDBOX_ANTHROPIC_KEY="$(security find-generic-password -s claude-sandbox -w 2>/dev/null || true)"
fi
[ -n "$SANDBOX_ANTHROPIC_KEY" ] || { echo "sbx-run: no API key. Run 'sbx-key' to store one in Keychain." >&2; exit 1; }
export ANTHROPIC_API_KEY="$SANDBOX_ANTHROPIC_KEY"
unset SANDBOX_ANTHROPIC_KEY

# --- per-run output dir -------------------------------------------------------
OUT="$SBX_OUT_ROOT/$(basename "$SRC")-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$OUT"
echo "sandbox: src=$SRC (ro)  out=$OUT  egress=${ALLOWED_HOSTS:-api.anthropic.com}" >&2

rc=0
container run $(sbx_tty) --rm \
  --dns 1.1.1.1 \
  --cap-add CAP_NET_ADMIN \
  --read-only --tmpfs /tmp --tmpfs /run --tmpfs /home/node \
  --mount "type=bind,source=$SRC,target=/work,readonly" \
  -v "$OUT:/out" \
  --cpus "${SBX_CPUS:-4}" --memory "${SBX_MEM:-4g}" \
  -e ANTHROPIC_API_KEY \
  ${ALLOWED_HOSTS:+-e ALLOWED_HOSTS="$ALLOWED_HOSTS"} \
  "$IMAGE" "$@" || rc=$?

# --- the sandbox wrote to $OUT: make it inert before anything on the host reads it
sbx_harden_dir "$OUT" defang
if [ -z "$(ls -A "$OUT")" ]; then rmdir "$OUT"; else echo "sandbox: output in $OUT (read-only, quarantined, dotfiles renamed _dot_*)" >&2; fi
exit $rc
